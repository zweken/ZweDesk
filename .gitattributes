# Normalise line endings in the repository; Windows checkouts get CRLF for the sources through core.autocrlf.
* text=auto

*.cs      text diff=csharp
*.csproj  text
*.ps1     text eol=crlf
*.js      text
*.css     text
*.html    text
*.md      text
*.txt     text
*.yml     text

*.png  binary
*.ico  binary
*.exe  binary
